{
    "name": "jimoh/laravel-activity-feed",
    "description": "A Laravel package for logging model events and manual activity to an activity log table.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "activity", "feed", "log", "audit"],
    "authors": [
        {
            "name": "Oluwasegun Jimoh",
            "email": "oluwasegunjimoh@gmail.com",
            "homepage": "https://github.com/tsdjimmy"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Jimoh\\ActivityFeed\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Jimoh\\ActivityFeed\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jimoh\\ActivityFeed\\ActivityFeedServiceProvider"
            ],
            "aliases": {
                "Activity": "Jimoh\\ActivityFeed\\Facades\\Activity"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest"
    }
}
